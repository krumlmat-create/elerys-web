{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/poptavka",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/poptavka/",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/objednat",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/objednat/",
      "destination": "/kontakt/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/znalosti/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/znalosti/",
      "permanent": true
    },
    {
      "source": "/poradna",
      "destination": "/znalosti/",
      "permanent": true
    },
    {
      "source": "/poradna/",
      "destination": "/znalosti/",
      "permanent": true
    },
    {
      "source": "/o-firme",
      "destination": "/o-nas/",
      "permanent": true
    },
    {
      "source": "/o-firme/",
      "destination": "/o-nas/",
      "permanent": true
    },
    {
      "source": "/kalkulacka-povinnosti",
      "destination": "/povinnosti-budov/",
      "permanent": true
    },
    {
      "source": "/kalkulacka-povinnosti/",
      "destination": "/povinnosti-budov/",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
